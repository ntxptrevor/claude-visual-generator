# NTXP Admin Console - environment template. PLACEHOLDERS ONLY.
# Real values live in the NTXP vault and the Hostinger project environment.
# Copy to admin_console/deploy/.env (local) or paste into the VPS project environment.
# Both .env paths are git-ignored. This repo is PUBLIC: never commit a real value.

# --- Compose / deploy ---------------------------------------------------------
# Set to "tls" only when the VPS has no other reverse proxy (Caddy then serves 80/443).
COMPOSE_PROFILES=
# Git branch/tag/commit the root compose builds the app from.
NTXP_ADMIN_GIT_REF=master
# Where oauth2-proxy publishes on the host (keep 127.0.0.1 behind a host proxy).
OAUTH2_PROXY_BIND_ADDR=127.0.0.1
OAUTH2_PROXY_BIND_PORT=4180

# --- Sign-in (oauth2-proxy, Google OAuth web client "NTXP Admin Console") -------
# Client ID of the Internal OAuth web client.
OAUTH2_PROXY_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Client secret of that client.
OAUTH2_PROXY_CLIENT_SECRET=GOCSPX-replace-me
# 32-character cookie secret (DEPLOY.md step b). Changing it signs everyone out.
OAUTH2_PROXY_COOKIE_SECRET=replace-with-32-char-secret-0000

# --- Google Workspace access layer (scripts/google_workspace) -------------------
# Service-account key JSON on one line (key mode). Required on the VPS.
NTXP_GOOGLE_SA_KEY={"type":"service_account","project_id":"ntxp-workspace-agent","private_key":"-----BEGIN PRIVATE KEY-----\\nREPLACE\\n-----END PRIVATE KEY-----\\n","client_email":"ntxp-workspace-agent@ntxp-workspace-agent.iam.gserviceaccount.com"}
# Keyless mode only (laptops with gcloud ADC); leave empty on the VPS.
NTXP_GOOGLE_SA_EMAIL=
# Super-admin account impersonated by default (needed for Directory/Reports).
NTXP_GOOGLE_ADMIN_SUBJECT=admin-user@ntxpllc.com
# Impersonation is limited to this domain.
NTXP_GOOGLE_DOMAIN=ntxpllc.com
# Maps Platform API key (geocoding, places).
NTXP_GOOGLE_MAPS_KEY=AIza-replace-me

# --- Console data and behaviour ------------------------------------------------
# Google Sheet ID of the Admin DB (runbook, flags, audit, shared contacts).
NTXP_ADMIN_DB_SHEET_ID=replace-with-sheet-id
# Google Contacts label that marks a contact as shared (exact text, with the star).
NTXP_SHARED_CONTACTS_LABEL=★ NTXP Shared
# Time zone for business hours (8-5) and quiet hours (9 pm-6 am).
NTXP_TIMEZONE=America/Chicago
# true = synthetic demo data, no live calls. Must be empty/false in production.
NTXP_ADMIN_DEMO=false
# Shared office mailboxes treated as "the office" in response-time KPIs (comma-separated).
NTXP_OFFICE_EMAILS=office@ntxpllc.com
# Who works which project: JSON text (or a file path), person -> projects / Drive folders.
NTXP_PROJECT_ASSIGNMENTS={"person@ntxpllc.com":[{"project":"Example Project","folder_id":"drive-folder-id"}]}
# Alternative source for assignments: path to the IPDM org file (same JSON shape).
NTXP_IPDM_ORG_FILE=
# Known project names for guided search, separated by | .
NTXP_PROJECT_NAMES=Example Project|Another Project
# Max Gmail threads read per person per analysis cycle.
NTXP_GMAIL_MAX_THREADS=300
# Analytics store file (the image sets /data/admin_intelligence.json on the app_data volume).
NTXP_ADMIN_DB_PATH=/data/admin_intelligence.json

# --- Model Council / models ----------------------------------------------------
# Base URL of the Model Council engine/MCP (council_run, council_route).
NTXP_COUNCIL_URL=https://council.example.invalid
# Google Sheet ID of the NTXP Model Council sheet (health check + ceilings).
NTXP_COUNCIL_SHEET_ID=replace-with-council-sheet-id
# Anthropic API key (Claude Haiku/Sonnet tiers).
ANTHROPIC_API_KEY=sk-ant-replace-me
# xAI API key (Grok council seat).
XAI_API_KEY=xai-replace-me
# Claude model used for the internal-only volatility check (Tier 1).
NTXP_VOLATILITY_MODEL=claude-haiku-4-5-20251001

# --- Data-source adapters ------------------------------------------------------
# JobTread API grant key (daily reports, POs, invoices, time).
JOBTREAD_GRANT_KEY=replace-me
# JobTread organization ID the adapter reads.
NTXP_JOBTREAD_ORG_ID=replace-me
# Plaud API key (meeting recordings/transcripts; personnel-confidential).
PLAUD_API_KEY=replace-me
# Plaud API base URL (default shown).
PLAUD_API_URL=https://api.plaud.ai
# QuickBooks Online access token (billing questions, PO/invoice integrity).
QBO_ACCESS_TOKEN=replace-me
# QuickBooks company (realm) ID.
QBO_REALM_ID=replace-me
# Person who owns open billing questions (default: first office mailbox).
QBO_BILLING_OWNER=office@ntxpllc.com
# Quo (phone system) API key - call/text metadata and L3 SMS alerts.
QUO_API_KEY=replace-me

# --- Escalation delivery -------------------------------------------------------
# Quo number that sends L3 alert texts, E.164.
QUO_FROM_NUMBER=+12145550100
# Alison Hopkins' mobile for L3 SMS, E.164.
NTXP_ALISON_SMS=+12145550101
# Trevor Hopkins' mobile for L3 SMS, E.164.
NTXP_TREVOR_SMS=+12145550102
# Mailbox that sends L2 alert emails (must be an active @ntxpllc.com user).
NTXP_ALERT_SENDER=alerts@ntxpllc.com
